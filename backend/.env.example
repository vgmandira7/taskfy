# Porta em que a API vai rodar
PORT=3000

# --- Banco de dados (PostgreSQL) ---

# Opção 1: Supabase / banco gerenciado na nuvem
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=sua_senha_aqui
# DB_SSL=true

# Opção 2: PostgreSQL local (ex: via docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskfy
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Define se a conexão exige SSL (true para Supabase/nuvem, false para local)
DB_SSL=false
